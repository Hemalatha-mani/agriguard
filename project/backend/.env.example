# Copy this file to .env for local development.
# Never commit the real .env file.

ENVIRONMENT=development

# PostgreSQL connection string
# Local example:  postgresql://postgres:postgres@localhost:5432/crop_disease_db
# Render example: provided automatically by your Render PostgreSQL instance
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Path to the trained Keras model file (relative to backend/ working directory)
MODEL_PATH=ml_models/crop_disease_model_final.keras
MODEL_INPUT_SIZE=224

MAX_UPLOAD_SIZE_MB=10
